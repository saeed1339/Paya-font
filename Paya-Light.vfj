ymbols default\nlanguagesystem nko  dflt; # N'Ko default\nlanguagesystem ogam dflt; # Ogham default\nlanguagesystem runr dflt; # Runic default\nlanguagesystem tfng dflt; # Tifinagh default\nlanguagesystem thai dflt; # Thai default\n\n#\n# Lookup definitions\n#\n\n\n#\n# Feature definitions\n#\n"
